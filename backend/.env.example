# EduFind Backend - Environment Variables
# Copy this file to .env and fill in the values

# Database URL (PostgreSQL for production, SQLite for dev)
DATABASE_URL=sqlite:///./edufind.db
# DATABASE_URL=postgresql://user:password@host:5432/edufind

# JWT Secret Key (REQUIRED in production - use a random 64-char string)
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# CORS Origins (comma-separated list of allowed frontend URLs)
# Use * for development, restrict in production
CORS_ORIGINS=*
# CORS_ORIGINS=https://your-frontend.onrender.com
